# Másold .env néven (a .env NEM kerül a repóba). A VITE_ előtagú változók bekerülnek a
# kliens-kódba, ezért itt csak nyilvános érték lehet.

# Mapbox NYILVÁNOS token (pk.…), lehetőleg URL-korlátozással (localhost, a helyi IP, a Vercel-domain).
VITE_MAPBOX_TOKEN=

# Supabase (Project Settings → API) – az anon kulcs nyilvános, az adatokat az RLS védi.
# Üresen az app offline fut, a beépített szakaszokkal. SERVICE ROLE kulcs SOHA ne kerüljön ide.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
