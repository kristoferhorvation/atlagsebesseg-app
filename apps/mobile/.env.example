# Másold .env néven (a .env NEM kerül a repóba), és töltsd ki.

# Mapbox NYILVÁNOS token (pk.…) – a térkép megjelenítéséhez. Az EXPO_PUBLIC_ előtag miatt bekerül
# az app kódjába, ezért csak pk. token lehet, lehetőleg URL/bundle-ID korlátozással.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Supabase (Project Settings → API). Az anon kulcs nyilvános, az adatokat az RLS védi.
# A SERVICE ROLE kulcs SOHA ne kerüljön ide – az csak a gyökér .env-be, helyi szkriptekhez.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opcionális, csak build-időben: a Mapbox már nem kéri a titkos letöltő tokent az SDK-hoz
# (a generált natív konfiguráció csak akkor használja, ha meg van adva). Ha mégis kellene:
# sk.… token DOWNLOADS:READ joggal. SOHA ne adj neki EXPO_PUBLIC_ előtagot.
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
