// Másold Secrets.xcconfig néven (gitignore-ban van, SOHA ne commitold), vagy töltsd ki a webes
// apps/web/.env-ből: npm run secrets -w @atlagsebesseg/ios
//
// FIGYELEM: az xcconfig-ban a `//` megjegyzést kezd, ezért az URL-ben így kell írni: https:/$()/xyz.supabase.co

// Mapbox nyilvános token (pk.…) – a térképhez
MAPBOX_ACCESS_TOKEN =

// Supabase projekt URL-je és a nyilvános anon kulcs (RLS védi az adatokat)
SUPABASE_URL = https:/$()/<projekt>.supabase.co
SUPABASE_ANON_KEY =
