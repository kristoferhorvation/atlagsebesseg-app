    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na úsekovém měření pokračuje měření i při zamčené obrazovce – proto potřebujeme tvou polohu i na pozadí, dokud je v aplikaci zapnuté GPS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Abschnittskontrollen läuft die Messung auch bei gesperrtem Bildschirm weiter – dafür wird dein Standort im Hintergrund gebraucht, solange GPS in der App an ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On average speed sections the measurement continues with the screen locked, so your location is needed in the background while GPS is on in the app."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szakaszellenőrzésen az átlagsebesség mérése zárolt képernyővel is folytatódik – ehhez a háttérben is kell a helyzeted, amíg a GPS be van kapcsolva az appban."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na odcinkowym pomiarze prędkości pomiar trwa także przy zablokowanym ekranie – dlatego lokalizacja jest potrzebna w tle, dopóki GPS w aplikacji jest włączony."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na úsekovom meraní pokračuje meranie aj pri zamknutej obrazovke – preto je tvoja poloha potrebná aj na pozadí, kým je v appke zapnuté GPS."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K rozpoznání úseků a měření průměrné rychlosti potřebujeme tvou polohu – i při zamčené obrazovce, dokud aplikace měří."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort wird gebraucht, um Messabschnitte zu erkennen und deine Durchschnittsgeschwindigkeit zu messen – auch bei gesperrtem Bildschirm, solange die App misst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to detect sections and measure your average speed, including while the screen is locked and the app is measuring."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mérőszakaszok felismeréséhez és az átlagsebesség méréséhez kell a helyzeted – zárolt képernyővel is, amíg az app mér."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja lokalizacja jest potrzebna do rozpoznawania odcinków i mierzenia średniej prędkości – także przy zablokowanym ekranie, dopóki aplikacja mierzy."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja poloha je potrebná na rozpoznanie úsekov a meranie priemernej rýchlosti – aj pri zamknutej obrazovke, kým appka meria."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
