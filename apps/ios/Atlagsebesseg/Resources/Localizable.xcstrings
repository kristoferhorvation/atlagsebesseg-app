    "report.note.default" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do hlášení se zapíše tvoje aktuální poloha a směr jízdy. Dočasný úsek: na konci měření tlačítko „Konec“ nahlásí koncovou bránu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine aktuelle Position und Fahrtrichtung werden mitgesendet. Temporärer Abschnitt: Am Ende der Messung meldest du mit „Ende“ den abschließenden Messpunkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current position and direction of travel are sent with the report. For a temporary section, tap “End” at the finish to report the closing gate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelenlegi helyed és haladási irányod kerül a bejelentésbe. Ideiglenes szakasz: a mérés végén a „Vége” gomb jelenti be a záró kaput."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do zgłoszenia trafia twoja bieżąca pozycja i kierunek jazdy. Odcinek tymczasowy: na końcu pomiaru przycisk „Koniec” zgłasza bramkę końcową."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do hlásenia sa zapíše tvoja aktuálna poloha a smer jazdy. Dočasný úsek: na konci merania tlačidlo „Koniec“ nahlási koncovú bránu."
          }
        }
      }
    },
    "report.note.gateEnd" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začátek úsekového měření je odeslán – konec nahlas na stejném místě."
          }
        },
        "de" : {
          "stringUnit" : {
