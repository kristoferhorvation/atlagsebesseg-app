    "settings.attribution" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data o úsecích a radarech: © OpenStreetMap contributors (ODbL); pevné body VÉDA: ORFK (2015); plánované kontroly: police.hu. Mapa: © Mapbox, © OpenStreetMap. Aplikace je informativní – rychlostní limit vždy určují dopravní značky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abschnittsdaten und Kameras: © OpenStreetMap contributors (ODbL); feste VÉDA-Punkte: ORFK (2015); geplante Kontrollen: police.hu. Karte: © Mapbox, © OpenStreetMap. Die App dient nur zur Information – das Tempolimit bestimmen immer die Schilder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Section data and cameras: © OpenStreetMap contributors (ODbL); fixed VÉDA points: ORFK (2015); planned checks: police.hu. Map: © Mapbox, © OpenStreetMap. The app is for information only – the signs always set the speed limit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szakaszadatok és kamerák: © OpenStreetMap contributors (ODbL); fix VÉDA-pontok: ORFK (2015); tervezett mérések: police.hu. Térkép: © Mapbox, © OpenStreetMap. Az app tájékoztató jellegű – a sebességhatárt mindig a táblák határozzák meg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane odcinków i fotoradarów: © OpenStreetMap contributors (ODbL); stałe punkty VÉDA: ORFK (2015); planowane kontrole: police.hu. Mapa: © Mapbox, © OpenStreetMap. Aplikacja ma charakter informacyjny – o limicie prędkości zawsze decydują znaki."
          }
        },
