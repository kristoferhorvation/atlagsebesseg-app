    "settings.shareHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zapnutí se na konci jízdy odešle: úsek silnice, počet průjezdů, průměrná rychlost, hodina, den v týdnu. Neodešle se: trasa, přesný čas, identifikátor, okolí uložených míst, začátek a konec jízd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, wird am Ende einer Fahrt gesendet: Straßenabschnitt, Anzahl der Durchfahrten, Durchschnittsgeschwindigkeit, Stunde, Wochentag. Nicht gesendet: Route, genaue Zeit, Kennung, die Umgebung gespeicherter Orte, Anfang und Ende der Fahrten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, the following is sent at the end of each trip: road segment, number of passes, average speed, hour of day, day of week. Never sent: route, exact time, identifier, the area around saved places, the start and end of trips."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekapcsolva az út végén felmegy: útszakasz, áthaladás-szám, átlagsebesség, óra-sáv, a hét napja. Nem megy fel: útvonal, pontos idő, azonosító, a mentett helyek környéke, az utak eleje és vége."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po włączeniu na końcu przejazdu wysyłane jest: odcinek drogi, liczba przejazdów, średnia prędkość, godzina, dzień tygodnia. Nie jest wysyłane: trasa, dokładny czas, identyfikator, okolice zapisanych miejsc, początek i koniec przejazdów."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zapnutí sa na konci jazdy odošle: úsek cesty, počet prejazdov, priemerná rýchlosť, hodina, deň v týždni. Neodošle sa: trasa, presný čas, identifikátor, okolie uložených miest, začiatok a koniec jázd."
          }
        }
      }
    },
