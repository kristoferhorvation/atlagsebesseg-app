            "value" : "Rendszerbeállítások › Adatvédelem és biztonság › Helymeghatározás: legyen bekapcsolva, a Safarinál is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia systemowe › Prywatność i ochrona › Usługi lokalizacji: włącz je, także dla Safari."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systémové nastavenia › Súkromie a zabezpečenie › Polohové služby: zapni ich, aj pre Safari."
          }
        }
      }
    },
    "geo.help.other.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nastavení webu v prohlížeči (ikona vedle adresního řádku) povol této stránce polohu a stránku znovu načti."
          }
        },
        "de" : {
          "stringUnit" : {
