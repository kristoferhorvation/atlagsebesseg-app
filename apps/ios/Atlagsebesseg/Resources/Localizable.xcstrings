    "ios.settings.cameraAlertHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je ve směru jízdy do 600 m kamera nebo začátek úsekového měření: krátký tón, hlášení a vibrace – u každé kamery jednou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liegt eine Kamera oder der Beginn einer Abschnittskontrolle innerhalb von 600 m in Fahrtrichtung: kurzer Ton, Ansage und Vibration – einmal pro Kamera."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a camera or the start of a section control is within 600 m ahead: a short tone, an announcement and a vibration – once per camera."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az útirányban 600 m-en belül kamera vagy szakaszellenőrzés kezdete van: rövid hang, bemondás és rezgés – kameránként egyszer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy kamera lub początek odcinkowego pomiaru jest do 600 m przed tobą: krótki dźwięk, komunikat i wibracja – raz dla każdej kamery."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je v smere jazdy do 600 m kamera alebo začiatok úsekovej kontroly: krátky tón, hlásenie a vibrácia – pri každej kamere raz."
          }
        }
      }
    },
