    "settings.plannedHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místa kontrol zveřejněná policií předem, jako slabá žlutá čára nebo plocha; na čáře, resp. v ploše nahoře ukáže pruh. Pevných kamer se to netýká."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der Polizei vorab veröffentlichte Kontrollstellen als blasse gelbe Linie oder Fläche; auf der Linie bzw. in der Fläche zeigt oben ein Balken den Hinweis. Feste Kameras sind nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check locations announced in advance by the police, as a faint yellow line or area; a bar at the top shows while you are on the line or in the area. Fixed cameras are not affected."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rendőrség által előre közzétett mérési helyszínek halvány sárga vonalként vagy területként; a vonalon, illetve a területen haladva felül sáv jelzi. A fix kamerákat nem érinti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsca kontroli ogłoszone wcześniej przez policję, jako blada żółta linia lub obszar; na linii albo w obszarze pasek u góry daje znać. Stałych kamer to nie dotyczy."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miesta kontrol zverejnené políciou vopred, ako slabá žltá čiara alebo plocha; na čiare, resp. v ploche hore ukáže pruh. Pevných kamier sa to netýka."
          }
        }
      }
    },
