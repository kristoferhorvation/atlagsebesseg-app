    "report.note.default" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do nahlášení se zapíše tvoje poloha a směr jízdy. Začátek / konec úsekového měření nahlásí neznámou zónu: vždy jednu bránu na tvé poloze."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine aktuelle Position und Fahrtrichtung werden mitgesendet. Abschnittsmessung Anfang / Ende meldet eine unbekannte Zone: je ein Tor an deiner Position."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current position and heading are included in the report. Average check start / end report an unknown zone: one gate each, at your position."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelenlegi helyed és haladási irányod kerül a bejelentésbe. Az Átlagmérés eleje / vége ismeretlen mérési zónát jelent be: egy-egy kaput a mostani helyeden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do zgłoszenia trafia twoja pozycja i kierunek jazdy. Początek / koniec odcinkowego pomiaru zgłasza nieznaną strefę: po jednej bramce w twoim miejscu."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do nahlásenia sa zapíše tvoja poloha a smer jazdy. Začiatok / koniec úsekového merania nahlási neznámu zónu: vždy jednu bránu na tvojej polohe."
          }
        }
      }
    },
    "report.note.gateEnd" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začátek úsekového měření jsi nahlásil – konec nahlas tady."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast den Beginn der Abschnittskontrolle gemeldet – melde das Ende hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You reported the start of the average-speed check – report its end right here."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Átlagmérés elejét elküldted – a végét ugyanitt jelezd."
          }
