          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezzel a névvel köszön az app a térképen és a navigáció indításakor. Üresen: „Szia!”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tym imieniem aplikacja wita Cię na mapie i przy starcie nawigacji. Puste: „Cześć!”"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto menom ťa aplikácia pozdraví na mape a pri spustení navigácie. Prázdne: „Ahoj!“"
          }
        }
      }
