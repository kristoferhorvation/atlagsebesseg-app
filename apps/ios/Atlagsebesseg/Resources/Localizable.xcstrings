    "geo.help.androidChrome.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepni na ikonu webu vlevo v adresním řádku › Oprávnění › Poloha: Povolit a stránku znovu načti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe links in der Adressleiste auf das Website-Symbol › Berechtigungen › Standort: Zulassen, dann lade die Seite neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the site icon on the left of the address bar › Permissions › Location: Allow, then reload the page."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints a címsor bal oldalán a webhely-ikonra › Engedélyek › Hely: Engedélyezés, majd töltsd újra az oldalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij ikony witryny po lewej stronie paska adresu › Uprawnienia › Lokalizacja: Zezwalaj, a potem odśwież stronę."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťukni na ikonu stránky vľavo od panela s adresou › Povolenia › Poloha: Povoliť, potom stránku znova načítaj."
          }
        }
      }
    },
    "geo.help.androidChrome.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení Androidu › Poloha: zapni ji a v Aplikace › Chrome › Oprávnění › Poloha zvol „Povolit jen při používání aplikace“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android-Einstellungen › Standort: Schalte ihn ein und wähle unter Apps › Chrome › Berechtigungen › Standort „Nur während der Nutzung der App zulassen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android Settings › Location: turn it on, then under Apps › Chrome › Permissions › Location choose “Allow only while using the app”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android-beállítások › Hely: legyen bekapcsolva, és az Alkalmazások › Chrome › Engedélyek › Hely: „Csak az alkalmazás használata közben”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia Androida › Lokalizacja: włącz ją, a w Aplikacje › Chrome › Uprawnienia › Lokalizacja wybierz „Zezwalaj tylko podczas używania aplikacji”."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavenia Androidu › Poloha: zapni ju a v Aplikácie › Chrome › Povolenia › Poloha zvoľ „Povoliť iba pri používaní aplikácie“."
          }
        }
      }
    },
    "geo.help.chrome.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikni na ikonu webu vlevo v adresním řádku › Nastavení webu › Poloha: Povolit a stránku znovu načti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke links in der Adressleiste auf das Website-Symbol › Website-Einstellungen › Standort: Zulassen, dann lade die Seite neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click the site icon on the left of the address bar › Site settings › Location: Allow, then reload the page."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kattints a címsor bal oldalán a webhely-ikonra › Webhelybeállítások › Hely: Engedélyezés, majd töltsd újra az oldalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij ikonę witryny po lewej stronie paska adresu › Ustawienia witryny › Lokalizacja: Zezwalaj, a potem odśwież stronę."
          }
        },
        "sk" : {
