    "settings.nameHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto jménem tě aplikace pozdraví na mapě a při spuštění navigace. Prázdné: „Ahoj!“"
          }
        },
        "de" : {
          "stringUnit" : {
