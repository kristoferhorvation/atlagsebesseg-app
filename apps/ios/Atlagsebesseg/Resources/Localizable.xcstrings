    "hud.interrupted.background" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pozadí není GPS, proto jsme měření ukončili – na začátku dalšího úseku se spustí znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Hintergrund gibt es kein GPS, darum wurde die Messung beendet – am Anfang des nächsten Abschnitts startet sie neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS doesn’t work in the background, so measuring stopped. It restarts at the start of the next section."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A háttérben nincs GPS, ezért lezártuk – a következő szakasz elején újraindul."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tle nie ma GPS, więc pomiar zakończono – na początku następnego odcinka ruszy od nowa."
