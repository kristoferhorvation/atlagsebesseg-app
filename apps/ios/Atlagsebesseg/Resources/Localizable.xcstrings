    "email.deleted.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostali jsme tvou žádost. Tvůj účet a k němu patřící data uložená na serveru budou za 30 dní trvale smazána. Pokud to chceš zrušit, přihlas se znovu do 30 dní a vše zůstane."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben deine Anfrage erhalten. Dein Konto und die zugehörigen auf dem Server gespeicherten Daten werden in 30 Tagen endgültig gelöscht. Doch anders entschieden? Melde dich innerhalb von 30 Tagen wieder an, dann bleibt alles erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We got your request. Your account and the data stored for it on the server will be permanently deleted in 30 days. Changed your mind? Sign in again within 30 days and everything stays."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megkaptuk a kérésedet. A fiókod és a hozzá tartozó, szerveren tárolt adatok 30 nap múlva véglegesen törlődnek. Ha meggondolod magad, jelentkezz be újra 30 napon belül, és minden megmarad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymaliśmy twoją prośbę. Twoje konto i powiązane dane na serwerze zostaną trwale usunięte za 30 dni. Jeśli chcesz to cofnąć, zaloguj się ponownie w ciągu 30 dni, a wszystko zostanie."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostali sme tvoju žiadosť. Tvoj účet a k nemu patriace údaje uložené na serveri sa o 30 dní natrvalo zmažú. Ak to chceš zrušiť, prihlás sa znova do 30 dní a všetko zostane."
          }
        }
      }
    },
    "email.deleted.subject" : {
