          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A határ mellett a tűréssel növelt érték ({percent}%, legalább {min} km/h). A színkód és a javaslat mindig a szigorú határhoz számol."
          }
        },
        "pl" : {
