    },
    "email.welcome.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje nastavení, uložená místa a – pokud ho zapneš – deník jízd jsou teď stejné na všech tvých zařízeních. Účet je dobrovolný: v Nastavení se můžeš kdykoli odhlásit nebo ho smazat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Einstellungen, gespeicherten Orte und – wenn du es einschaltest – dein Fahrtenbuch sind jetzt auf allen deinen Geräten gleich. Ein Konto ist freiwillig: Du kannst dich jederzeit in den Einstellungen abmelden oder es löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your settings, saved places and – if you turn it on – your trip log are now the same on all your devices. An account is optional: you can sign out or delete it any time in Settings."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beállításaid, a mentett helyeid és – ha bekapcsolod – az utak naplója mostantól minden készülékeden ugyanaz. A fiók nem kötelező: a Beállításokban bármikor kijelentkezhetsz vagy törölheted."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje ustawienia, zapisane miejsca i – jeśli go włączysz – dziennik jazd są teraz takie same na wszystkich twoich urządzeniach. Konto jest dobrowolne: w Ustawieniach możesz w każdej chwili się wylogować lub je usunąć."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje nastavenia, uložené miesta a – ak ho zapneš – denník jázd sú odteraz rovnaké na všetkých tvojich zariadeniach. Účet je dobrovoľný: v Nastaveniach sa môžeš kedykoľvek odhlásiť alebo ho zmazať."
          }
        }
      }
    },
