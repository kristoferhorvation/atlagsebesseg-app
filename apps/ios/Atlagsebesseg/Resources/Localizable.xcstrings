    "email.change.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepni na tlačítko a tato adresa bude patřit tvému účtu. Odkaz platí jednou a 1 hodinu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Schaltfläche, dann gehört diese Adresse zu deinem Konto. Der Link gilt einmal und 1 Stunde lang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the button and this address becomes your account’s. The link works once, for 1 hour."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints a gombra, és ez a cím lesz a fiókodé. A link 1 óráig és egyszer használható."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij przycisk, a ten adres będzie należeć do Twojego konta. Link działa raz, przez 1 godzinę."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťukni na tlačidlo a táto adresa bude patriť tvojmu účtu. Odkaz platí raz a 1 hodinu."
          }
        }
      }
    },
