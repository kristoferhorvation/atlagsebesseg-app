        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A böngésző webhely-beállításaiban (a címsor melletti ikon) engedélyezd ennek az oldalnak a helyhozzáférést, majd töltsd újra az oldalt."
          }
