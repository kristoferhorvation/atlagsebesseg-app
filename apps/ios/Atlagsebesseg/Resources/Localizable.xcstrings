            "value" : "Czego nie wysyłamy"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čo sa neodošle"
          }
        }
      }
    },
    "heat.details.noPlaces" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím nejsou uložena žádná místa – můžeš je přidat v Nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine gespeicherten Orte – in den Einstellungen kannst du welche hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No saved places yet – you can add some in Settings."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs mentett hely – a Beállításokban adhatsz hozzá."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma jeszcze zapisanych miejsc – możesz je dodać w ustawieniach."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatiaľ nemáš uložené miesta – pridať ich môžeš v Nastaveniach."
          }
        }
      }
    },
    "heat.details.title" : {
