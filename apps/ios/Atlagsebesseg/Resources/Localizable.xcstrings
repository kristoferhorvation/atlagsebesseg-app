    "account.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepovinné: aplikace funguje naplno i bez něj. Po přihlášení máš místa a nastavení na všech zařízeních."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional: Die App funktioniert auch ohne vollständig. Angemeldet hast du deine Orte und Einstellungen auf all deinen Geräten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional: the app works fully without it. Signed in, your places and settings are on all your devices."
          }
        },
        "hu" : {
