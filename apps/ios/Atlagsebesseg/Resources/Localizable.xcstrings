            "value" : "Ustawienia › Prywatność i ochrona › Usługi lokalizacji: włącz je, a dla Witryn Safari wybierz „Podczas używania aplikacji”."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavenia › Súkromie a zabezpečenie › Polohové služby: zapni ich a pri Webových stránkach Safari zvoľ „Počas používania aplikácie“."
          }
        }
      }
    },
    "geo.help.iosSafari.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V Safari otevři nabídku vedle adresního řádku (aA) › Nastavení webové stránky › Poloha: Povolit a stránku znovu načti."
          }
