          }
        }
      }
    },
    "geo.help.chrome.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systémová poloha musí být zapnutá i pro Chrome (na Macu: Nastavení systému › Soukromí a zabezpečení › Polohové služby)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standortfreigabe des Systems muss auch für Chrome eingeschaltet sein (am Mac: Systemeinstellungen › Datenschutz & Sicherheit › Ortungsdienste)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System location must also be on for Chrome (on a Mac: System Settings › Privacy & Security › Location Services)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rendszer helymeghatározása is legyen bekapcsolva a Chrome-nak (Macen: Rendszerbeállítások › Adatvédelem és biztonság › Helymeghatározás)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalizacja systemowa też musi być włączona dla Chrome (na Macu: Ustawienia systemowe › Prywatność i ochrona › Usługi lokalizacji)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polohové služby systému musia byť zapnuté aj pre Chrome (na Macu: Systémové nastavenia › Súkromie a zabezpečenie › Polohové služby)."
          }
        }
      }
    },
    "geo.help.iosSafari.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení › Soukromí a zabezpečení › Polohové služby: zapni je a u Webových stránek Safari zvol „Při používání aplikace“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen › Datenschutz & Sicherheit › Ortungsdienste: Schalte sie ein und wähle bei Safari-Websites „Beim Verwenden der App“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings › Privacy & Security › Location Services: turn it on, and set Safari Websites to “While Using the App”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítások › Adatvédelem és biztonság › Helymeghatározás: legyen bekapcsolva, és a Safari-webhelyeknél válaszd: „Az app használata közben”."
