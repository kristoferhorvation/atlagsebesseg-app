    "heat.details.up.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za každý úsek silnice (asi 25 m): počet průjezdů, průměrná rychlost, hodina (0–23) a den v týdnu. Nic jiného."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Straßenabschnitt (etwa 25 m): die Anzahl der Durchfahrten, die Durchschnittsgeschwindigkeit, die Stunde (0–23) und der Wochentag. Sonst nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per road segment (about 25 m): the number of passes, the average speed, the hour of day (0–23) and the day of week. Nothing else."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útszakaszonként (kb. 25 m): az áthaladások száma, az átlagsebesség, az óra-sáv (0–23) és a hét napja. Semmi más."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla każdego odcinka drogi (ok. 25 m): liczba przejazdów, średnia prędkość, godzina (0–23) i dzień tygodnia. Nic więcej."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za každý úsek cesty (asi 25 m): počet prejazdov, priemerná rýchlosť, hodina (0–23) a deň v týždni. Nič iné."
          }
        }
      }
    },
    "heat.details.up.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
