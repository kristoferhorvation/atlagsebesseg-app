    "settings.heatHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastní vzniká z tvých jízd a zůstává jen v tomto zařízení. Komunitní ukazuje anonymní data ostatních řidičů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Eigene“ entsteht aus deinen Fahrten und bleibt auf diesem Gerät. „Community“ zeigt anonyme Daten anderer Fahrer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mine” is built from your own trips and stays on this device. “Community” shows other drivers’ anonymous data."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A saját mód a megtett utaidból készül, csak ezen a készüléken. A közösségi mód mások névtelen adatait mutatja."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własna powstaje z twoich przejazdów i zostaje na tym urządzeniu. Społeczności pokazuje anonimowe dane innych kierowców."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastná vzniká z tvojich jázd a zostáva len v tomto zariadení. Komunitná ukazuje anonymné údaje ostatných vodičov."
          }
        }
      }
    },
