    "heat.details.no.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasa, přesný čas, jakýkoli identifikátor (jméno, zařízení, účet), okolí uložených míst a prvních a posledních 300 m každé jízdy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Route, die genaue Zeit, jede Kennung (Name, Gerät, Konto), die Umgebung gespeicherter Orte sowie die ersten und letzten 300 m jeder Fahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The route, the exact time, any identifier (name, device, account), the area around saved places, and the first and last 300 m of every trip."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az útvonal, a pontos idő, bármilyen azonosító (név, eszköz, fiók), a mentett helyek környéke, és az utak első és utolsó 300 m-e."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasy, dokładnego czasu, żadnego identyfikatora (imię, urządzenie, konto), okolic zapisanych miejsc ani pierwszych i ostatnich 300 m każdego przejazdu."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasa, presný čas, akýkoľvek identifikátor (meno, zariadenie, účet), okolie uložených miest a prvých a posledných 300 m každej jazdy."
          }
        }
      }
    },
    "heat.details.no.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co se neodešle"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
