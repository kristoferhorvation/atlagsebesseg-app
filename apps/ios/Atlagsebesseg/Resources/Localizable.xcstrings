    "settings.plannedHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místa kontrol zveřejněná policií předem, jako nevýrazná žlutá čára nebo plocha; na čáře či v oblasti tě nahoře upozorní pruh. Pevných radarů se to netýká."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der Polizei vorab veröffentlichte Kontrollstellen als blassgelbe Linie oder Fläche; auf der Linie bzw. in der Fläche erscheint oben ein Balken. Feste Blitzer sind nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locations of police checks announced in advance, shown as a faint yellow line or area. A bar appears at the top while you’re on the line or in the area. Fixed cameras are not affected."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rendőrség által előre közzétett mérési helyszínek halvány sárga vonalként vagy területként; a vonalon, illetve a területen haladva felül sáv jelzi. A fix kamerákat nem érinti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsca kontroli ogłoszone wcześniej przez policję: jasnożółta linia lub obszar. Gdy jedziesz po linii albo w obszarze, u góry pojawia się pasek. Stałych fotoradarów to nie dotyczy."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miesta kontrol, ktoré polícia zverejnila vopred, ako slabá žltá čiara alebo plocha; keď ideš po čiare alebo v ploche, hore sa zobrazí pruh. Pevných radarov sa to netýka."
          }
        }
      }
    },
