    "geo.help.androidChrome.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na ikonu webu vlevo v adresním řádku › Oprávnění › Poloha: Povolit a stránku znovu načtěte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf das Website-Symbol links in der Adressleiste tippen › Berechtigungen › Standort: Zulassen, dann die Seite neu laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the site icon on the left of the address bar › Permissions › Location: Allow, then reload the page."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints a címsor bal oldalán a webhely-ikonra › Engedélyek › Hely: Engedélyezés, majd töltsd újra az oldalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij ikony witryny po lewej stronie paska adresu › Uprawnienia › Lokalizacja: Zezwalaj, a potem odśwież stronę."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťuknite na ikonu stránky vľavo v paneli s adresou › Povolenia › Poloha: Povoliť a stránku znova načítajte."
          }
        }
      }
    },
    "geo.help.androidChrome.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení Androidu › Poloha: zapněte ji a v Aplikace › Chrome › Oprávnění › Poloha zvolte „Povolit jen při používání aplikace“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android-Einstellungen › Standort: einschalten, und Apps › Chrome › Berechtigungen › Standort: „Nur während der Nutzung der App zulassen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android Settings › Location: turn it on, and Apps › Chrome › Permissions › Location: “Allow only while using the app”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android-beállítások › Hely: legyen bekapcsolva, és az Alkalmazások › Chrome › Engedélyek › Hely: „Csak az alkalmazás használata közben”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia Androida › Lokalizacja: włącz ją, a w Aplikacje › Chrome › Uprawnienia › Lokalizacja wybierz „Zezwalaj tylko podczas używania aplikacji”."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavenia Androidu › Poloha: zapnite ju a v Aplikácie › Chrome › Povolenia › Poloha zvoľte „Povoliť iba pri používaní aplikácie“."
          }
        }
      }
    },
    "geo.help.chrome.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikněte na ikonu webu vlevo v adresním řádku › Nastavení webu › Poloha: Povolit a stránku znovu načtěte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf das Website-Symbol links in der Adressleiste klicken › Website-Einstellungen › Standort: Zulassen, dann die Seite neu laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click the site icon on the left of the address bar › Site settings › Location: Allow, then reload the page."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kattints a címsor bal oldalán a webhely-ikonra › Webhelybeállítások › Hely: Engedélyezés, majd töltsd újra az oldalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij ikonę witryny po lewej stronie paska adresu › Ustawienia witryny › Lokalizacja: Zezwalaj, a potem odśwież stronę."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite na ikonu stránky vľavo v paneli s adresou › Nastavenia stránky › Poloha: Povoliť a stránku znova načítajte."
          }
        }
      }
    },
    "geo.help.chrome.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systémová poloha musí být pro Chrome také zapnutá (na Macu: Nastavení systému › Soukromí a zabezpečení › Polohové služby)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch der System-Standort muss für Chrome an sein (am Mac: Systemeinstellungen › Datenschutz & Sicherheit › Ortungsdienste)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System location must be on for Chrome too (on a Mac: System Settings › Privacy & Security › Location Services)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rendszer helymeghatározása is legyen bekapcsolva a Chrome-nak (Macen: Rendszerbeállítások › Adatvédelem és biztonság › Helymeghatározás)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalizacja systemowa też musi być włączona dla Chrome (na Macu: Ustawienia systemowe › Prywatność i ochrona › Usługi lokalizacji)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systémová poloha musí byť pre Chrome tiež zapnutá (na Macu: Systémové nastavenia › Súkromie a bezpečnosť › Polohové služby)."
          }
        }
      }
    },
    "geo.help.iosSafari.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení › Soukromí a zabezpečení › Polohové služby: zapněte je a u Webových stránek Safari zvolte „Při používání aplikace“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen › Datenschutz & Sicherheit › Ortungsdienste: einschalten und bei Safari-Websites „Beim Verwenden der App“ wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings › Privacy & Security › Location Services: turn it on, and set Safari Websites to “While Using the App”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítások › Adatvédelem és biztonság › Helymeghatározás: legyen bekapcsolva, és a Safari-webhelyeknél válaszd: „Az app használata közben”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia › Prywatność i ochrona › Usługi lokalizacji: włącz je, a dla Witryn Safari wybierz „Podczas używania aplikacji”."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavenia › Súkromie a bezpečnosť › Polohové služby: zapnite ich a pri Webových stránkach Safari zvoľte „Pri používaní apky“."
          }
        }
      }
    },
    "geo.help.iosSafari.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V Safari otevřete nabídku vedle adresního řádku (aA) › Nastavení webových stránek › Poloha: Povolit a stránku znovu načtěte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Safari das Menü neben der Adressleiste (aA) › Website-Einstellungen › Standort: Erlauben, dann die Seite neu laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Safari, open the menu next to the address bar (aA) › Website Settings › Location: Allow, then reload the page."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Safariban a címsor melletti menü (aA) › Webhely-beállítások › Hely: Engedélyezés, majd töltsd újra az oldalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Safari otwórz menu obok paska adresu (aA) › Ustawienia witryny › Lokalizacja: Pozwalaj, a potem odśwież stronę."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V Safari otvorte ponuku vedľa panela s adresou (aA) › Nastavenia webovej stránky › Poloha: Povoliť a stránku znova načítajte."
          }
        }
      }
    },
