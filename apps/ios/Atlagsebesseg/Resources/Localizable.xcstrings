    "ios.settings.cameraAlertHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je ve směru jízdy do 600 m radar nebo začátek úsekového měření: krátký tón, hlášení a vibrace – u každého radaru jednou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liegt ein Blitzer oder der Beginn einer Abschnittskontrolle innerhalb von 600 m in Fahrtrichtung: kurzer Ton, Ansage und Vibration – einmal pro Blitzer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a camera or the start of a section control is within 600 m on your route: a short tone, a voice announcement and vibration – once per camera."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az útirányban 600 m-en belül kamera vagy szakaszellenőrzés kezdete van: rövid hang, bemondás és rezgés – kameránként egyszer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy fotoradar lub początek odcinkowego pomiaru jest do 600 m przed tobą: krótki dźwięk, komunikat i wibracja – raz dla każdego fotoradaru."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je v smere jazdy do 600 m radar alebo začiatok úsekovej kontroly: krátky tón, hlásenie a vibrácia – pri každom radare raz."
          }
        }
      }
    },
