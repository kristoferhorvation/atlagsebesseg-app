    "heat.details.zones.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolem každého uloženého místa (Domov, Práce, další) je zóna, ve výchozím stavu 200 m. Úseky silnic v zónách se nikdy neodešlou a na tvé vlastní teplotní mapě jsou šedé. Zóny a uložená místa se nikdy nedostanou do komunitních dat; po přihlášení se synchronizují jen s tvým vlastním účtem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um jeden gespeicherten Ort (Zuhause, Arbeit, weitere) liegt eine Zone, standardmäßig 200 m. Straßenabschnitte in einer Zone werden nie gesendet und erscheinen auf deiner eigenen Heatmap grau. Zonen und gespeicherte Orte gelangen nie in die Community-Daten; angemeldet werden sie nur mit deinem eigenen Konto synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every saved place (Home, Work, others) has a zone around it, 200 m by default. Road segments inside a zone are never sent and show in grey on your own heatmap. Zones and saved places never reach the community data; when signed in they sync only with your own account."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden mentett hely (Haza, Munka, egyéb) körül zóna van, alapból 200 m. A zónákban lévő útszakaszok sosem mennek fel, a saját hőtérképen szürkén jelennek meg. A zónák és a mentett helyek a közösségi adatokba sosem kerülnek; bejelentkezve csak a saját fiókodban szinkronizálódnak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wokół każdego zapisanego miejsca (Dom, Praca, inne) jest strefa, domyślnie 200 m. Odcinki dróg w strefach nigdy nie są wysyłane, a na twojej własnej mapie cieplnej są szare. Strefy i zapisane miejsca nigdy nie trafiają do danych wspólnych; po zalogowaniu synchronizują się tylko z twoim własnym kontem."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okolo každého uloženého miesta (Domov, Práca, ďalšie) je zóna, predvolene 200 m. Úseky ciest v zónach sa nikdy neodošlú a na tvojej vlastnej tepelnej mape sú sivé. Zóny a uložené miesta sa nikdy nedostanú do komunitných údajov; po prihlásení sa synchronizujú len s tvojím vlastným účtom."
          }
        }
      }
    },
