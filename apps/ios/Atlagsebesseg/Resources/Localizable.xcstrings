    "ios.settings.alertModeHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuk zazní bez ohledu na přepínač tichého režimu, i při zamčené obrazovce; hudba se mezitím ztlumí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ton erklingt unabhängig vom Stummschalter, auch bei gesperrtem Bildschirm; Musik wird währenddessen leiser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sound plays regardless of the silent switch and with the screen locked; music is turned down meanwhile."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hang a némítás-kapcsolótól függetlenül, zárolt képernyőn is szól; közben a zene halkabb."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dźwięk odtwarzany jest niezależnie od przełącznika wyciszenia, także przy zablokowanym ekranie; muzyka jest w tym czasie ściszana."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
