# Gyökér .env – CSAK helyi szkriptekhez (import-feltöltés, migráció, élő tesztek).
# Másold .env néven; a .env gitignore-ban van, SOHA ne commitold.
# Az app (apps/mobile) saját .env-et használ: apps/mobile/.env.example.

# Supabase projekt URL-je (Project Settings → API)
SUPABASE_URL=

# Nyilvános anon kulcs (az app is ezt használja; RLS védi az adatokat)
SUPABASE_ANON_KEY=

# Közvetlen Postgres-kapcsolat CSAK a migrációhoz és az élő tesztekhez (npm run db:live)
# (Project Settings → Database → Connection string, „Session pooler” vagy direkt)
SUPABASE_DB_URL=

# TITKOS service role kulcs – CSAK a szakasz-feltöltő szkripthez (npm run upload:sections).
# Megkerüli az RLS-t: soha ne kerüljön az appba, a repóba vagy EXPO_PUBLIC_ változóba.
SUPABASE_SERVICE_ROLE_KEY=

# Opcionális: más Overpass-végpont az importhoz
# OVERPASS_ENDPOINT=https://overpass.kumi.systems/api/interpreter
