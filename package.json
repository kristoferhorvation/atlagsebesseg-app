{
  "name": "atlagsebesseg-app",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspace @atlagsebesseg/core --workspace @atlagsebesseg/data",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "import:sections": "npm run import --workspace @atlagsebesseg/data",
    "db:live": "supabase/tests/run-live.sh",
    "db:test:local": "supabase/tests/run-local.sh",
    "build:edge": "npm run build:edge --workspace @atlagsebesseg/data",
    "test:edge": "npm run build:edge && deno test --allow-env supabase/functions/promote-temp-gates/",
    "deploy:edge": "npm run build:edge && supabase functions deploy promote-temp-gates",
    "upload:sections": "npm run upload --workspace @atlagsebesseg/data"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=11"
  },
  "packageManager": "npm@11.21.1",
  "devDependencies": {
    "deno": "^2.9.6",
    "supabase": "^2.122.0"
  }
}
